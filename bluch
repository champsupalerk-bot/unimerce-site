<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Blue</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #0b0b0b;
  color: #f5f1eb;
  font-family: "DM Sans", sans-serif;
  font-weight: 300;
  overflow-x: hidden;
}

body.no-scroll {
  overflow: hidden;
}

img {
  display: block;
  width: 100%;
}

button {
  font-family: inherit;
}

:root {
  --cream: #f5f1eb;
  --muted: #aaa49c;
  --dark: #0b0b0b;
  --warm: #d9c9b5;
}

/* =========================
   LOADER
========================= */

#loader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #0b0b0b;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 1s ease, visibility 1s ease;
}

#loader.hide {
  opacity: 0;
  visibility: hidden;
}

.loader-text {
  font-family: "Playfair Display", serif;
  font-size: 24px;
  letter-spacing: .04em;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%,100% { opacity: .35; }
  50% { opacity: 1; }
}

/* =========================
   GLOBAL
========================= */

.grain {
  position: fixed;
  inset: -50%;
  z-index: 100;
  pointer-events: none;
  opacity: .055;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
  transform: rotate(7deg);
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 74px;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  mix-blend-mode: difference;
}

.logo {
  font-size: 14px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.sound {
  border: 0;
  background: transparent;
  color: white;
  font-size: 11px;
  letter-spacing: .16em;
  cursor: pointer;
  text-transform: uppercase;
}

.progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 2px;
  width: 0%;
  background: white;
  z-index: 300;
}

/* =========================
   HERO
========================= */

.hero {
  height: 100svh;
  min-height: 680px;
  position: relative;
  overflow: hidden;
}

.hero-image {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to bottom, rgba(0,0,0,.08), rgba(0,0,0,.62)),
    url("https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571562/hokkaido002_uoo5wc.jpg");
  background-size: cover;
  background-position: center;
  transform: scale(1.06);
  transition: transform 2s ease;
}

.loaded .hero-image {
  transform: scale(1);
}

.hero-content {
  position: absolute;
  left: 8vw;
  bottom: 10vh;
  max-width: 700px;
}

.eyebrow {
  font-size: 11px;
  letter-spacing: .25em;
  text-transform: uppercase;
  color: #d7d2ca;
  margin-bottom: 20px;
}

.hero h1 {
  font-family: "Playfair Display", serif;
  font-size: clamp(56px, 10vw, 130px);
  line-height: .9;
  font-weight: 400;
  letter-spacing: -.045em;
}

.scroll-note {
  position: absolute;
  bottom: 30px;
  right: 30px;
  font-size: 10px;
  letter-spacing: .2em;
  text-transform: uppercase;
  writing-mode: vertical-rl;
  color: #ddd;
}

/* =========================
   TEXT SECTIONS
========================= */

.text-section {
  min-height: 100svh;
  padding: 18vh 9vw;
  display: flex;
  align-items: center;
}

.text-inner {
  max-width: 800px;
}

.text-section h2 {
  font-family: "Playfair Display", serif;
  font-weight: 400;
  font-size: clamp(44px, 7vw, 92px);
  line-height: .98;
  letter-spacing: -.035em;
}

.text-section p {
  max-width: 510px;
  margin-top: 35px;
  font-size: 17px;
  line-height: 1.8;
  color: var(--muted);
}

/* =========================
   FULL IMAGE
========================= */

.full-image {
  height: 100svh;
  min-height: 600px;
  position: relative;
  overflow: hidden;
}

.full-image img {
  height: 100%;
  object-fit: cover;
  transform: scale(1.08);
  transition: transform 1.5s cubic-bezier(.2,.7,.2,1);
}

.full-image.visible img {
  transform: scale(1);
}

.image-caption {
  position: absolute;
  left: 7vw;
  bottom: 7vh;
  max-width: 600px;
}

.image-caption .small {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .2em;
  margin-bottom: 14px;
}

.image-caption h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(40px, 6vw, 80px);
  font-weight: 400;
  line-height: 1;
}

/* =========================
   TWO IMAGE
========================= */

.two-image {
  min-height: 100svh;
  padding: 12vh 7vw;
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 5vw;
  align-items: center;
}

.photo-card {
  overflow: hidden;
  background: #151515;
}

.photo-card img {
  aspect-ratio: 4 / 5;
  object-fit: cover;
  transition: transform 1s ease;
}

.photo-card:hover img {
  transform: scale(1.03);
}

.photo-copy {
  padding-right: 5vw;
}

.photo-copy h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(42px, 6vw, 76px);
  font-weight: 400;
  line-height: 1;
}

.photo-copy p {
  color: var(--muted);
  line-height: 1.8;
  margin-top: 30px;
  max-width: 440px;
}

/* =========================
   MEMORIES
========================= */

.memories {
  padding: 15vh 0;
  overflow: hidden;
}

.memories-header {
  padding: 0 8vw 60px;
}

.memories-header h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(45px, 7vw, 90px);
  font-weight: 400;
}

.memory-track {
  display: flex;
  gap: 24px;
  width: max-content;
  padding-left: 8vw;
}

.memory {
  width: min(70vw, 430px);
  flex-shrink: 0;
}

.memory img {
  aspect-ratio: 3 / 4;
  object-fit: cover;
}

.memory-caption {
  padding-top: 18px;
}

.memory-caption span {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .18em;
  color: #777;
}

.memory-caption h3 {
  font-family: "Playfair Display", serif;
  font-size: 28px;
  font-weight: 400;
  margin-top: 8px;
}

/* =========================
   CAKE FLIP
========================= */

.cake-section {
  min-height: 150svh;
  position: relative;
  padding: 12vh 7vw;
}

.cake-intro {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 80px;
}

.cake-intro .eyebrow {
  color: #777;
}

.cake-intro h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(48px, 7vw, 90px);
  line-height: .98;
  font-weight: 400;
}

.cake-intro p {
  color: var(--muted);
  line-height: 1.8;
  max-width: 480px;
  margin: 28px auto 0;
}

.cake-stage {
  height: 85svh;
  min-height: 600px;
  display: flex;
  justify-content: center;
  align-items: center;
  perspective: 1600px;
}

.cake-card {
  width: min(76vw, 520px);
  aspect-ratio: 4 / 5;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
}

.cake-card.flipped {
  transform: rotateY(180deg);
}

.cake-face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
  background: #161616;
}

.cake-face img {
  height: 100%;
  width: 100%;
  object-fit: cover;
}

.cake-back {
  transform: rotateY(180deg);
}

.cake-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 55px 35px 30px;
  background: linear-gradient(transparent, rgba(0,0,0,.82));
}

.cake-overlay span {
  font-size: 10px;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.cake-overlay h3 {
  font-family: "Playfair Display", serif;
  font-size: 30px;
  font-weight: 400;
  margin-top: 8px;
}

.cake-note {
  text-align: center;
  margin-top: 40px;
  color: #777;
  font-size: 11px;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.cake-reveal {
  text-align: center;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity .8s ease, transform .8s ease;
  margin-top: 60px;
}

.cake-reveal.show {
  opacity: 1;
  transform: translateY(0);
}

.cake-reveal .big {
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 5vw, 65px);
}

.cake-reveal p {
  color: var(--muted);
  margin-top: 15px;
}

/* =========================
   TRAVEL
========================= */

.travel {
  padding: 15vh 7vw;
}

.travel-title {
  text-align: center;
  margin-bottom: 100px;
}

.travel-title h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(50px, 8vw, 100px);
  font-weight: 400;
}

.travel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5vw;
  align-items: start;
}

.travel-item:nth-child(2) {
  margin-top: 15vh;
}

.travel-item img {
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.travel-item .caption {
  padding-top: 20px;
}

.travel-item .caption h3 {
  font-family: "Playfair Display", serif;
  font-size: 32px;
  font-weight: 400;
}

.travel-item .caption p {
  margin-top: 10px;
  color: var(--muted);
  line-height: 1.7;
}

/* =========================
   QUIET
========================= */

.quiet {
  min-height: 100svh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12vh 7vw;
}

.quiet-inner {
  max-width: 900px;
  text-align: center;
}

.quiet-inner h2 {
  font-family: "Playfair Display", serif;
  font-weight: 400;
  font-size: clamp(48px, 8vw, 105px);
  line-height: .95;
}

.quiet-inner p {
  color: #777;
  max-width: 470px;
  margin: 35px auto 0;
  line-height: 1.8;
}

/* =========================
   PROPOSAL
========================= */

.proposal {
  min-height: 100svh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  background:
    radial-gradient(circle at center, #24201c 0%, #0b0b0b 58%);
}

.proposal-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 30px;
}

.proposal .eyebrow {
  color: #999;
}

.proposal h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(60px, 10vw, 130px);
  line-height: .88;
  font-weight: 400;
}

.question {
  margin-top: 30px;
  font-size: 16px;
  color: #aaa;
}

.buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-top: 50px;
  min-height: 80px;
}

.btn {
  min-width: 130px;
  height: 52px;
  padding: 0 30px;
  border-radius: 100px;
  border: 1px solid rgba(255,255,255,.35);
  background: transparent;
  color: white;
  cursor: pointer;
  transition: all .25s ease;
}

.btn-yes {
  background: white;
  color: #111;
  border-color: white;
}

.btn-yes:hover {
  transform: scale(1.06);
}

.btn-no {
  position: relative;
}

/* =========================
   FINAL
========================= */

.final {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: #0b0b0b;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 1.2s ease, visibility 1.2s ease;
  overflow: hidden;
}

.final.show {
  opacity: 1;
  visibility: visible;
}

.final-content {
  position: relative;
  z-index: 3;
  padding: 30px;
}

.final h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(70px, 12vw, 160px);
  line-height: .85;
  font-weight: 400;
}

.final p {
  color: #aaa;
  margin-top: 30px;
  font-size: 16px;
}

.final img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: .28;
}

.final-sign {
  margin-top: 50px;
  font-size: 11px;
  letter-spacing: .25em;
  text-transform: uppercase;
}

.confetti {
  position: absolute;
  width: 7px;
  height: 7px;
  background: white;
  top: -20px;
  animation: fall 4s linear forwards;
  z-index: 5;
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(720deg);
    opacity: 0;
  }
}

/* =========================
   REVEAL
========================= */

.reveal {
  opacity: 0;
  transform: translateY(45px);
  transition:
    opacity 1s cubic-bezier(.2,.7,.2,1),
    transform 1s cubic-bezier(.2,.7,.2,1);
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

  .topbar {
    height: 60px;
    padding: 0 18px;
  }

  .hero-content {
    left: 22px;
    bottom: 80px;
    right: 22px;
  }

  .hero h1 {
    font-size: 65px;
  }

  .scroll-note {
    right: 18px;
    bottom: 22px;
  }

  .text-section {
    min-height: 90svh;
    padding: 14vh 24px;
  }

  .text-section h2 {
    font-size: 48px;
  }

  .text-section p {
    font-size: 15px;
  }

  .full-image {
    height: 78svh;
    min-height: 500px;
  }

  .image-caption {
    left: 24px;
    right: 24px;
    bottom: 40px;
  }

  .image-caption h2 {
    font-size: 47px;
  }

  .two-image {
    display: block;
    padding: 12vh 24px;
  }

  .photo-copy {
    padding: 45px 0 0;
  }

  .photo-copy h2 {
    font-size: 48px;
  }

  .memory {
    width: 78vw;
  }

  .memories {
    padding: 12vh 0;
  }

  .cake-section {
    min-height: 150svh;
    padding: 12vh 24px;
  }

  .cake-intro {
    margin-bottom: 30px;
  }

  .cake-intro h2 {
    font-size: 50px;
  }

  .cake-stage {
    height: 72svh;
    min-height: 520px;
  }

  .cake-card {
    width: min(82vw, 430px);
  }

  .travel {
    padding: 12vh 24px;
  }

  .travel-grid {
    display: block;
  }

  .travel-item:nth-child(2) {
    margin-top: 70px;
  }

  .travel-item .caption h3 {
    font-size: 28px;
  }

  .quiet {
    padding: 12vh 24px;
  }

  .quiet-inner h2 {
    font-size: 54px;
  }

  .proposal h2 {
    font-size: 67px;
  }

  .buttons {
    gap: 12px;
  }

  .btn {
    min-width: 115px;
    padding: 0 22px;
  }
}
</style>
</head>

<body>

<div id="loader">
  <div class="loader-text">for blue</div>
</div>

<div class="grain"></div>

<div class="progress" id="progress"></div>

<header class="topbar">
  <div class="logo">C & B</div>
  <button class="sound" id="soundBtn">Sound Off</button>
</header>

<main>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-image"></div>

    <div class="hero-content">
      <div class="eyebrow">A little story about us</div>
      <h1>For<br>Blue.</h1>
    </div>

    <div class="scroll-note">Scroll slowly</div>
  </section>


  <!-- INTRO -->
  <section class="text-section">
    <div class="text-inner reveal">
      <div class="eyebrow">Before the question</div>
      <h2>It started with the little things.</h2>

      <p>
        The places we went.<br>
        The ridiculous moments.<br>
        The quiet ones.<br>
        And all the ordinary days that somehow became my favorite memories.
      </p>
    </div>
  </section>


  <!-- BLUE READING -->
  <section class="two-image">
    <div class="photo-card reveal">
      <img
        src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571579/sitincondo_l5uuk0.jpg"
        alt="Blue reading a book"
      >
    </div>

    <div class="photo-copy reveal">
      <div class="eyebrow">Five years ago</div>
      <h2>You were 26.</h2>

      <p>
        I don't think we knew then how many memories
        were waiting for us.
      </p>
    </div>
  </section>


  <!-- SHADOW -->
  <section class="full-image reveal">
    <img
      src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571579/shadow_zr3fuu.jpg"
      alt="Our shadows in Japan"
    >

    <div class="image-caption">
      <div class="small">Somewhere in Japan</div>
      <h2>Just two shadows.<br>Still together.</h2>
    </div>
  </section>


  <!-- CAMPING -->
  <section class="two-image">

    <div class="photo-copy reveal">
      <div class="eyebrow">In the beginning</div>
      <h2>We didn't know what we were doing.</h2>

      <p>
        Our first camping trips were far from perfect.
        We barely knew how to set up the tent.
        We had almost no equipment.
        But somehow, we had everything we needed.
      </p>
    </div>

    <div class="photo-card reveal">
      <img
        src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571573/s001v_vhnluw.jpg"
        alt="Our early camping trip"
      >
    </div>

  </section>


  <!-- APEC -->
  <section class="full-image reveal">
    <img
      src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571570/apex_lwqi1k.jpg"
      alt="APEC 2022"
    >

    <div class="image-caption">
      <div class="small">APEC 2022</div>
      <h2>Some days were<br>a little bigger.</h2>
    </div>
  </section>


  <!-- MEMORIES -->
  <section class="memories">

    <div class="memories-header reveal">
      <div class="eyebrow">The memories</div>
      <h2>All the little chapters.</h2>
    </div>

    <div class="memory-track">

      <div class="memory">
        <img
          src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571581/nucket_shark_doll_aidk8k.jpg"
          alt="Blue and her favorite shark doll"
        >
        <div class="memory-caption">
          <span>One ordinary day</span>
          <h3>The shark mission.</h3>
        </div>
      </div>

      <div class="memory">
        <img
          src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571573/halloween_yl5uds.jpg"
          alt="Halloween together"
        >
        <div class="memory-caption">
          <span>Halloween</span>
          <h3>We were ridiculous.</h3>
        </div>
      </div>

      <div class="memory">
        <img
          src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571568/blulovebird_xsubqx.jpg"
          alt="Blue feeding birds"
        >
        <div class="memory-caption">
          <span>Another little moment</span>
          <h3>You being you.</h3>
        </div>
      </div>

    </div>

  </section>


  <!-- CAKE FLIP -->
  <section class="cake-section">

    <div class="cake-intro reveal">
      <div class="eyebrow">A little thing I remember</div>

      <h2>You made me<br>a birthday cake.</h2>

      <p>
        And you drew the rainbow yourself.
        A little wobbly, a little imperfect,
        and completely you.
      </p>
    </div>

    <div class="cake-stage">

      <div class="cake-card" id="cakeCard">

        <!-- FRONT -->
        <div class="cake-face">
          <img
            src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571569/hbdchamp001_mfdhel.jpg"
            alt="Birthday cake from above"
          >

          <div class="cake-overlay">
            <span>Birthday</span>
            <h3>You made this for me.</h3>
          </div>
        </div>

        <!-- BACK -->
        <div class="cake-face cake-back">
          <img
            src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571568/hbdchamp002_ucqoul.jpg"
            alt="Side view of birthday cake with rainbow"
          >

          <div class="cake-overlay">
            <span>The rainbow</span>
            <h3>Exactly the way you drew it.</h3>
          </div>
        </div>

      </div>

    </div>

    <div class="cake-note">
      Keep scrolling ↓
    </div>

    <div class="cake-reveal" id="cakeReveal">
      <div class="big">
        It wasn't perfect.
      </div>

      <p>
        That's what made it perfect.
      </p>
    </div>

  </section>


  <!-- KHAO YAI -->
  <section class="full-image reveal">
    <img
      src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571563/khaoyaiblu_y0svu1.jpg"
      alt="Blue at Khao Yai"
    >

    <div class="image-caption">
      <div class="small">Khao Yai</div>
      <h2>And sometimes<br>you looked like this.</h2>
    </div>
  </section>


  <!-- TRAVEL -->
  <section class="travel">

    <div class="travel-title reveal">
      <div class="eyebrow">Places we've been</div>
      <h2>We've gone<br>somewhere.</h2>
    </div>

    <div class="travel-grid">

      <div class="travel-item reveal">

        <img
          src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571566/soultower_ajlfwt.jpg"
          alt="Love lock at Seoul Tower"
        >

        <div class="caption">
          <h3>Seoul.</h3>
          <p>
            We left a little piece of us there.
          </p>
        </div>

      </div>

      <div class="travel-item reveal">

        <img
          src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571586/hokkaido003_vvbrcw.jpg"
          alt="Hokkaido"
        >

        <div class="caption">
          <h3>Hokkaido.</h3>
          <p>
            Cold air. Snow. And you beside me.
          </p>
        </div>

      </div>

    </div>

  </section>


  <!-- HOKKAIDO -->
  <section class="full-image reveal">
    <img
      src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571582/hokkaido001_ucgmay.jpg"
      alt="Hokkaido"
    >

    <div class="image-caption">
      <div class="small">Hokkaido</div>
      <h2>My favorite rides<br>are the ones with you.</h2>
    </div>
  </section>


  <!-- QUIET -->
  <section class="quiet">

    <div class="quiet-inner reveal">

      <div class="eyebrow">After all these years</div>

      <h2>
        My favorite place
        is still beside you.
      </h2>

      <p>
        So there is just one thing left
        I want to ask you.
      </p>

    </div>

  </section>


  <!-- PROPOSAL -->
  <section class="proposal" id="proposal">

    <div class="proposal-inner">

      <div class="eyebrow">One last question</div>

      <h2>
        Will you<br>
        marry me?
      </h2>

      <div class="question">
        Choose carefully.
      </div>

      <div class="buttons">

        <button class="btn btn-yes" id="yesBtn">
          YES
        </button>

        <button class="btn btn-no" id="noBtn">
          NO
        </button>

      </div>

    </div>

  </section>

</main>


<!-- FINAL -->
<div class="final" id="finalScreen">

  <img
    src="https://res.cloudinary.com/dzgaej1wo/image/upload/v1788571562/hokkaido002_uoo5wc.jpg"
    alt=""
  >

  <div class="final-content">

    <div class="eyebrow">
      I knew you'd say yes.
    </div>

    <h2>
      Forever<br>
      sounds good.
    </h2>

    <p>
      Let's make the rest of our story even better.
    </p>

    <div class="final-sign">
      C & B · To be continued
    </div>

  </div>

</div>


<script>
/* =========================
   LOADER
========================= */

window.addEventListener("load", () => {
  setTimeout(() => {
    document.getElementById("loader").classList.add("hide");
    document.body.classList.add("loaded");
  }, 900);
});


/* =========================
   PROGRESS
========================= */

window.addEventListener("scroll", () => {

  const scrollTop = window.scrollY;
  const height =
    document.documentElement.scrollHeight -
    document.documentElement.clientHeight;

  const progress = height > 0
    ? (scrollTop / height) * 100
    : 0;

  document.getElementById("progress").style.width =
    progress + "%";

});


/* =========================
   REVEAL
========================= */

const revealObserver = new IntersectionObserver(
  entries => {
    entries.forEach(entry => {

      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }

    });
  },
  {
    threshold: 0.15
  }
);

document.querySelectorAll(".reveal").forEach(el => {
  revealObserver.observe(el);
});


/* =========================
   FULL IMAGE OBSERVER
========================= */

const imageObserver = new IntersectionObserver(
  entries => {

    entries.forEach(entry => {

      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }

    });

  },
  {
    threshold: 0.2
  }
);

document.querySelectorAll(".full-image").forEach(el => {
  imageObserver.observe(el);
});


/* =========================
   CAKE FLIP
========================= */

const cakeSection = document.querySelector(".cake-section");
const cakeCard = document.getElementById("cakeCard");
const cakeReveal = document.getElementById("cakeReveal");

let cakeFlipped = false;

function updateCake() {

  const rect = cakeSection.getBoundingClientRect();
  const sectionHeight = cakeSection.offsetHeight;
  const viewport = window.innerHeight;

  const progress =
    Math.min(
      1,
      Math.max(
        0,
        (viewport - rect.top) /
        (sectionHeight - viewport)
      )
    );

  /*
    Flip roughly in the middle of the section.
  */

  if (progress > 0.32 && !cakeFlipped) {
    cakeCard.classList.add("flipped");
    cakeFlipped = true;
  }

  if (progress > 0.62) {
    cakeReveal.classList.add("show");
  }

}

window.addEventListener("scroll", updateCake);
updateCake();


/* =========================
   NO BUTTON
========================= */

const noBtn = document.getElementById("noBtn");
const proposal = document.getElementById("proposal");

let noCount = 0;

function moveNoButton() {

  noCount++;

  const proposalRect =
    proposal.getBoundingClientRect();

  const maxX =
    Math.max(
      80,
      Math.min(
        window.innerWidth - 160,
        proposalRect.width - 160
      )
    );

  const maxY = 180;

  const x =
    Math.random() * maxX -
    maxX / 2;

  const y =
    Math.random() * maxY -
    maxY / 2;

  noBtn.style.position = "fixed";
  noBtn.style.left = "50%";
  noBtn.style.top = "50%";

  noBtn.style.transform =
    `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;

  const texts = [
    "NO",
    "Are you sure?",
    "Really?",
    "Think again.",
    "Nope.",
    "Try YES.",
    "Come on...",
    "You know the answer.",
    "YES is right there."
  ];

  noBtn.textContent =
    texts[Math.min(noCount, texts.length - 1)];

}

noBtn.addEventListener("mouseenter", moveNoButton);
noBtn.addEventListener("touchstart", e => {
  e.preventDefault();
  moveNoButton();
});

noBtn.addEventListener("click", moveNoButton);


/* =========================
   YES
========================= */

const yesBtn = document.getElementById("yesBtn");
const finalScreen = document.getElementById("finalScreen");

yesBtn.addEventListener("click", () => {

  finalScreen.classList.add("show");
  document.body.classList.add("no-scroll");

  createConfetti();

});


/* =========================
   CONFETTI
========================= */

function createConfetti() {

  for (let i = 0; i < 90; i++) {

    const piece =
      document.createElement("div");

    piece.className = "confetti";

    piece.style.left =
      Math.random() * 100 + "vw";

    piece.style.animationDelay =
      Math.random() * 2 + "s";

    piece.style.animationDuration =
      3 + Math.random() * 3 + "s";

    piece.style.transform =
      `rotate(${Math.random() * 360}deg)`;

    finalScreen.appendChild(piece);

  }

}


/* =========================
   PARALLAX
========================= */

window.addEventListener("scroll", () => {

  const hero = document.querySelector(".hero-image");

  if (!hero) return;

  const y = window.scrollY;

  if (y < window.innerHeight) {
    hero.style.transform =
      `scale(1.04) translateY(${y * 0.08}px)`;
  }

});


/* =========================
   SOUND BUTTON
========================= */

const soundBtn =
  document.getElementById("soundBtn");

let soundOn = false;

soundBtn.addEventListener("click", () => {

  soundOn = !soundOn;

  soundBtn.textContent =
    soundOn ? "Sound On" : "Sound Off";

});


/* =========================
   HORIZONTAL MEMORY
========================= */

const memoryTrack =
  document.querySelector(".memory-track");

window.addEventListener("scroll", () => {

  const memories =
    document.querySelector(".memories");

  if (!memories || !memoryTrack) return;

  const rect =
    memories.getBoundingClientRect();

  const start = window.innerHeight;
  const end = -memories.offsetHeight;

  if (rect.top < start && rect.bottom > 0) {

    const total =
      memories.offsetHeight +
      window.innerHeight;

    const progress =
      Math.min(
        1,
        Math.max(
          0,
          (window.innerHeight - rect.top) /
          total
        )
      );

    const distance =
      Math.max(
        0,
        memoryTrack.scrollWidth -
        window.innerWidth
      );

    memoryTrack.style.transform =
      `translateX(-${distance * progress}px)`;

  }

});
</script>

</body>
</html>
